# Supabase Project Credentials for Production Persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET=your-supabase-service-role-secret

# Application URL (for OAuth redirect callbacks, e.g. https://hotspots-v1.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://hotspots-v1.vercel.app
APP_URL=https://hotspots-v1.vercel.app
